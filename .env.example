# Application
APP_NAME=Betting Platform
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database and cache (development defaults only)
DATABASE_URL=postgresql+asyncpg://betting:betting@postgres:5432/betting
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=betting
POSTGRES_USER=betting
POSTGRES_PASSWORD=betting

# External provider; required only for real-provider smoke/sync commands
ODDS_API_KEY=

# Telegram; required only for the bot process
TELEGRAM_BOT_TOKEN=

# Future signed webhooks/payment integrations
PAYMENT_WEBHOOK_SECRET=
